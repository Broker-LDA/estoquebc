# Cole em Environment do APP no EasyPanel. Substitua somente os dois segredos/host.
APP_ENV=production
DATABASE_URL=postgresql+psycopg://estoque_app:SENHA_CODIFICADA@HOST_INTERNO:5432/estoque_brasilcacau
SECRET_KEY=SUBSTITUA_POR_UMA_CHAVE_ALEATORIA_GERADA_COM_SECRETS_TOKEN_HEX
PUBLIC_BASE_URL=https://estoquebc.ldalogistica.com.br
TRUSTED_HOSTS=estoquebc.ldalogistica.com.br
COOKIE_SECURE=true
TRUST_PROXY=true
RUN_MIGRATIONS=true
DATABASE_STARTUP_TIMEOUT=120
PORT=8000
WEB_CONCURRENCY=2
GUNICORN_THREADS=2
COUNT_INTERVAL_DAYS=15
EXPIRY_ALERT_DAYS=40

# Opcional para verificação de e-mail e recuperação; preencha com o SMTP da empresa.
SMTP_HOST=
SMTP_PORT=587
SMTP_SSL=false
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
